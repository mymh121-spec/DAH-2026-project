{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simulation decision v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "threat", "response"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "threat": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_threat", "threat_domain", "severity", "confidence", "detected_effects", "reason"],
      "properties": {
        "primary_threat": {"type": "string", "pattern": "\\S"},
        "threat_domain": {"type": "string", "pattern": "\\S"},
        "severity": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "detected_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["communication_degradation", "position_information_loss", "command_integrity_risk", "sensor_integrity_risk", "optical_sensor_degradation", "physical_damage_risk"]}},
        "reason": {"type": "string", "pattern": "\\S"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["situation_code", "priority", "action_code", "recommended_action", "allowed_control_intent", "restricted_actions", "reason"],
      "properties": {
        "situation_code": {"type": "string", "pattern": "\\S"},
        "priority": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "action_code": {"type": "string", "enum": ["CONTINUE", "HOLD", "RETURN_TO_BASE", "REPOSITION"]},
        "recommended_action": {"type": "string", "pattern": "\\S"},
        "allowed_control_intent": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["CONTINUE", "HOLD", "RETURN_TO_BASE", "REPOSITION"]}},
        "restricted_actions": {"type": "array", "uniqueItems": true, "minItems": 2, "maxItems": 2, "items": {"type": "string", "enum": ["offensive_action_generation", "direct_actuator_fire_control"]}},
        "reason": {"type": "string", "pattern": "\\S"}
      }
    }
  }
}
